{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "baseUrl": ".",
    "paths": {
      "@lotso-trading/shared": ["packages/shared/src/index.ts"],
      "@lotso-trading/shared/*": ["packages/shared/src/*"]
    }
  },
  "include": ["packages/*/src/**/*", "services/*/src/**/*", "services/*/src/**/*.vue"]
}
