# ==============================================================================
# Polymarket Copy-Trading Monorepo Configuration
# ==============================================================================

# --- Polymarket CLOB Credentials ---
# Clé privée exportée depuis Polymarket (Settings -> Export Private Key)
POLYMARKET_PRIVATE_KEY=
# Adresse Funder de votre profil Polymarket (détentrice des USDC.e et des parts)
POLYMARKET_FUNDER_ADDRESS=

# Signature type: 0 = EOA/MetaMask, 1 = Magic/Email Proxy (Recommandé pour compte Email), 2 = Polymarket Safe
POLYMARKET_SIGNATURE_TYPE=1
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
# Service de réclamation automatique gasless (Auto-Redeem pour comptes Email/Proxy)
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com

# --- Polygon Blockchain (On-Chain Detection Fallback) ---
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_WS_RPC_URL=wss://polygon-mainnet.g.alchemy.com/v2/your_alchemy_key
POLYGON_CHAIN_ID=137
CTF_EXCHANGE_ADDRESS=
NEG_RISK_EXCHANGE_ADDRESS=

# --- Database (MongoDB) ---
MONGODB_URI=mongodb://root:example@mongodb:27017/polymarket_copy?authSource=admin
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
MONGO_INITDB_DATABASE=polymarket_copy

# --- Discord Alerting Webhooks ---
# Webhook dédié aux ordres BUY exécutés
DISCORD_BUY_WEBHOOK_URL=https://discord.com/api/webhooks/
# Webhook dédié aux ordres SELL et clôtures de positions (résolutions & sorties)
DISCORD_SELL_WEBHOOK_URL=https://discord.com/api/webhooks/
DISCORD_CLOSED_POSITIONS_WEBHOOK_URL=https://discord.com/api/webhooks/
# Pas de webhook pour les rejets (filtrés automatiquement)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/

# --- Trading Strategy & Risk Management ---
# DRY_RUN: true = Paper trading (Simulation sans dépenser d'USDC), false = Ordres réels
DRY_RUN=true
SIMULATED_BALANCE_USDC=1000.0
# Dimensionnement du capital : pourcentage fixe du solde disponible (ex: 0.08 = 8% recommandé pour 50 USDC)
BALANCE_PERCENT_PER_TRADE=0.08
# Plancher minimum par trade pour petits capitaux (évite le blocage sous 1.0 USDC)
MIN_TRADE_SIZE_USDC=2.0
# Slippage maximum toléré en pourcentage (ex: 2.0 = 2%)
MAX_SLIPPAGE_PERCENT=2.0
# Plafond maximum en USDC par trade copié
MAX_CAP_PER_TRADE_USDC=50
# Réplication intégrale des sorties (SELL partiels et totaux)
COPY_SELL_ORDERS=true
# Bornes de cotes acceptées (évite d'acheter au-dessus de 90% ou en-dessous de 5%)
MIN_PRICE_THRESHOLD=0.05
MAX_PRICE_THRESHOLD=0.90

# --- Services Networking ---
API_PORT=3000
API_HOST=0.0.0.0
API_INTERNAL_URL=http://api:3000
DASHBOARD_PORT=5173
VITE_API_BASE_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
